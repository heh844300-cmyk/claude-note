{
  "name": "Claude 筆記",
  "short_name": "Claude 筆記",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#f6f5fb",
  "theme_color": "#5b4bdb",
  "lang": "zh-Hant",
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any maskable" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" }
  ],
  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        { "name": "files", "accept": ["image/*", "audio/*", "text/plain", ".m4a", ".mp3", ".wav", ".ogg", ".amr", ".txt", ".md"] }
      ]
    }
  }
}
